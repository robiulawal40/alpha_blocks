{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "alphablock/accordion-item",
  "version": "1.2.3",
  "title": "Accordion Item",
  "category": "widgets",
  "icon": "excerpt-view",
  "attributes": {
    "accordionsContent": {
      "type": "array",
      "default": [
        {
          "accordionItem": "Item 1",
          "accordionContent": "The Content"
        },
        {
          "accordionItem": "Item 2",
          "accordionContent": "The Content"
        },
        {
          "accordionItem": "Item 3",
          "accordionContent": "The Content"
        }
      ]
    },
    "itemTitle": {
      "type": "string",
      "default": "Accordion Title"
    },
    "itemContent": {
      "type": "string",
      "default": "Accordion Content"
    },
    "activeIconName": {
      "type": "string",
      "default": "chevron-down"
    },
    "inactiveIconName": {
      "type": "string",
      "default": "chevron-up"
    },
    "itemTitleTag": {
      "type": "string",
      "default": "span"
    }
  },
  "supports": {
    "customClassName": false,
    "__experimentalGroup": {
      "advanced": false
    }
  },
  "editorScript": "file:./index.js",
  "textdomain": "my-example-template-block-item"
}