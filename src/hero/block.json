{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "alphablock/hero",
  "version": "1.2.3",
  "title": "Hero",
  "category": "widgets",
  "icon": "editor-insertmore",
  "attributes": {
    "answerPadding": {
      "type": "object",
      "default": {
        "desktop": {
          "borderTop": "15",
          "borderRight": "15",
          "borderBottom": "15",
          "borderLeft": "15",
          "unit": "px"
        }
      }
    }
  },
  "supports": {
    "customClassName": false,
    "__experimentalGroup": {
      "advanced": false
    }
  },
  "textdomain": "my-example-template-block",
  "editorScript": "file:./index.js",
  "editorStyle": ["alpha-admin-css"],
  "script": "alpine",
  "style": "alpha-block-tailwind-style"
}
